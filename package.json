{
  "name": "software-construction-workshop-2",
  "version": "1.0.0",
  "description": "TypeScript utility library for practical workshop 2",
  "main": "dist/index.cjs",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/demo.ts",
    "prepare": "husky",
    "test": "npm run build && node --test tests/smoke.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Allighierri/software-construction-workshop-2.git"
  },
  "keywords": [
    "typescript",
    "semver",
    "workshop"
  ],
  "author": "Allighierri",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/Allighierri/software-construction-workshop-2/issues"
  },
  "homepage": "https://github.com/Allighierri/software-construction-workshop-2#readme",
  "dependencies": {
    "dotenv": "^18.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.2",
    "commitlint": "^21.2.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ]
}
